# ══════════════════════════════════════════════════════════════════════════════
# HMS Backend — Environment Variables (12-Factor Compliant)
#
# REQUIRED vars: App will crash on boot if these are missing.
# OPTIONAL vars: Have safe defaults — set only if you need to override.
# ══════════════════════════════════════════════════════════════════════════════

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string — AWS RDS
DATABASE_URL=postgresql://postgres:your-password@your-db.xxxxxxxxxxxx.eu-west-2.rds.amazonaws.com:5432/postgres

# Self-managed JWT — generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-key-change-me

# Paystack payment gateway — https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

# ── AWS S3 — file storage (photos, medical docs) ───────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=eu-west-2
AWS_BUCKET_NAME=your-s3-bucket-name

# ── OPTIONAL (safe defaults) ────────────────────────────────────────────────

JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
PAYSTACK_CALLBACK_URL=https://your-app.vercel.app/payment/callback
HOSTEL_FEE_AMOUNT=15000

# NL query routing (admin natural-language query feature)
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Frontend URL (used in email templates)
HMS_APP_URL=http://localhost:5173

# CORS — comma-separated list of allowed frontend URLs
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ── Email — two-tier fallback: Google Apps Script -> Gmail SMTP ────────────
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
SMTP_EMAIL=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password
RESEND_API_KEY=re_your-resend-api-key

# File uploads directory (local fallback only — primary storage is S3)
UPLOAD_DIR=./uploads

# Database connection pool sizing (per worker)
DB_POOL_MIN=1
DB_POOL_MAX=3

# ══════════════════════════════════════════════════════════════════════════════
# HMS — Root Environment Variables (for docker-compose)
#
# Copy to .env and fill in your values:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# Docker Compose port overrides (optional)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend API URL (injected at build time)
VITE_API_URL=http://localhost:8000/api/v1
